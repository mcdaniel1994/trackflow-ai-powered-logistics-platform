# Disposable local PostgreSQL from compose.yml. Replace the password after copying.
POSTGRES_DB=trackflow_inventory
POSTGRES_USER=trackflow
POSTGRES_PASSWORD=replace-with-local-only-password
DATABASE_URL=postgresql+psycopg2://trackflow:replace-with-local-only-password@127.0.0.1:55432/trackflow_inventory
MIGRATION_DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000

# Trusted browser origins only; credentials are never paired with a wildcard origin.
CENTRAL_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Telemetry (Engagement 6). Best-effort diagnostics are emitted only when enabled.
# APP_ENV labels the environment on every stored event; keep prod/non-prod distinct.
# Do NOT set TELEMETRY_ENABLED=true in production until the retention prune job is
# wired to a scheduler (see docs/runbooks/telemetry-inventory.md).
APP_ENV=local
TELEMETRY_ENABLED=false
TELEMETRY_OPERATIONAL_RETENTION_DAYS=90
TELEMETRY_SECURITY_RETENTION_DAYS=365

# Identity signs access tokens; Central API receives only the verification key.
IDENTITY_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-local-identity-public-key\n-----END PUBLIC KEY-----
IDENTITY_JWT_ALGORITHM=RS256
IDENTITY_JWT_ISSUER=trackflow-identity
IDENTITY_JWT_AUDIENCE=trackflow-backoffice
IDENTITY_OAUTH_ISSUER_URL=http://localhost:8002
IDENTITY_OAUTH_INTERNAL_URL=http://localhost:8002
CENTRAL_API_OAUTH_RESOURCE_URL=http://localhost:8003

# Must be an existing local Identity user UUID before running the seed command.
SEED_USER_UUID=

# RAG knowledge base (Engagement 7). The /knowledge/query endpoint stays disabled
# until RAG_ENABLED=true and both provider keys are set. Qdrant is self-hosted
# (see compose.yaml). Embedding and generation MUST be different models.
RAG_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RAG_COLLECTION=trackflow
# Embeddings provider (dedicated embeddings model, separate from generation).
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIM=1536
# Generation provider (OpenAI-compatible; key already available for DeepSeek).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_GENERATION_MODEL=deepseek-chat
RAG_TOP_K=5
RAG_MIN_SCORE=0.35

# Engagement 8 agent MCP transport. Provision the confidential client with the
# Identity operator CLI; never commit or log its secret.
AGENT_MCP_URL=http://localhost:8004/mcp
AGENT_MCP_RESOURCE_URL=http://localhost:8004/mcp
AGENT_MCP_OAUTH_CLIENT_ID=
AGENT_MCP_OAUTH_CLIENT_SECRET=
